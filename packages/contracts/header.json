{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perf-panel.local/contracts/header.json",
  "title": "Contract Header",
  "description": "Global contract version identifier shared across all schemas",
  "type": "object",
  "required": ["contractVersion", "lastUpdated"],
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "type": "string",
      "description": "SemVer contract version. All schemas and protocols in this directory share this version.",
      "default": "1.0.0",
      "examples": ["1.0.0"]
    },
    "lastUpdated": {
      "type": "string",
      "description": "ISO 8601 date of last revision",
      "default": "2026-05-05",
      "examples": ["2026-05-05"]
    },
    "compatibilityNote": {
      "type": "string",
      "description": "Human-readable compatibility promise summary"
    }
  }
}
